# API key of the provider selected in config.yaml -> paraphrase.provider.
# Only the one for the provider you use is required, ollama needs none.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Translator API key. Not needed for the free providers (google, mymemory).
# Required only for deepl.
TRANSLATOR_API_KEY=

# Optional HTTP proxy for the LLM requests (openrouter, openai and gemini).
LLM_PROXY=
